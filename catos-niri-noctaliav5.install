post_install() {
    echo "==> 正在应用 greetd 默认配置..."
    # 强制覆盖 /etc/greetd/config.toml
    cp -f /usr/share/catos-niri-noctaliav5/greetd-config.toml /etc/greetd/config.toml

    echo "==> 正在启用 greetd 服务..."
    systemctl enable greetd.service

    echo "==> 完成！greetd 已配置为默认使用 Niri + Noctalia。"
}

post_upgrade() {
    post_install
}
